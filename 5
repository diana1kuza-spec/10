# Упрощенное меню банкомата.
# Начальный баланс 1000 руб. Инициализация переменной ДО цикла.

balans = 1000

while True:
    print("\nМеню:")
    print("1. Узнать баланс")
    print("2. Снять 100 руб")
    print("3. Положить 100 руб")
    print("4. Выход")
    
    try:
        komanda = int(input("Выберите действие: "))
    except ValueError:
        print("Неверная команда")
        continue

    if komanda == 1:
        print(f"Текущий баланс: {balans} руб.")
    elif komanda == 2:
        if balans >= 100:
            balans -= 100
            print("Снято 100 руб.")
        else:
            print("Недостаточно средств")
    elif komanda == 3:
        balans += 100
        print("Баланс пополнен на 100 руб.")
    elif komanda == 4:
        print("До свидания")
        break
    else:
        print("Неверная команда")
