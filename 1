# Эмуляция электронного замка
# Правильный пин-код
PRAVILNYY_PIN = 4590

while True:
    try:
        # Запрашиваем ввод, преобразуем в целое число
        vvod = int(input("Введите пин-код: "))
    except ValueError:
        # Если введено не число, обрабатываем как ошибку
        print("Ошибка. Попробуйте еще раз")
        continue

    if vvod == PRAVILNYY_PIN:
        print("Доступ разрешен")
        break
    else:
        print("Ошибка. Попробуйте еще раз")
