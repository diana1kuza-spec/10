# Программа запрашивает три числа и проверяет их на строгое возрастание.
# При ошибке запрашивает только текущее (неверное) число заново.

# 1. Запрашиваем первое число
while True:
    try:
        chislo1 = int(input("Запросите первое число: "))
        break
    except ValueError:
        print("Ошибка: введите целое число")

# 2. Запрашиваем второе число (должно быть больше первого)
while True:
    try:
        chislo2 = int(input("Запросите второе число: "))
    except ValueError:
        print("Ошибка: введите целое число")
        continue

    if chislo2 <= chislo1:
        print("Ошибка. Введите второе число заново (оно должно быть больше первого).")
    else:
        break

# 3. Запрашиваем третье число (должно быть больше второго)
while True:
    try:
        chislo3 = int(input("Запросите третье число: "))
    except ValueError:
        print("Ошибка: введите целое число")
        continue

    if chislo3 <= chislo2:
        print("Ошибка. Введите третье число заново (оно должно быть больше второго).")
    else:
        break

print("Последовательность принята")
