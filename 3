# Программа ищет максимальное число в последовательности.
# 0 — сигнал остановки.

# Инициализируем переменную для максимума.
# Используем очень маленькое число, чтобы первое введенное точно стало максимумом.
maximum = -1 
# Флаг, чтобы понять, было ли введено хотя бы одно число
est_chisla = False

while True:
    try:
        chislo = int(input("Введите натуральное число (0 для выхода): "))
    except ValueError:
        print("Ошибка: введите целое число")
        continue

    # Проверка на сигнал остановки
    if chislo == 0:
        break

    # Если число положительное (натуральное), сравниваем с текущим максимумом
    if chislo > maximum:
        maximum = chislo
        est_chisla = True

# Вывод результата
if est_chisla:
    print(f"Самое большое число: {maximum}")
else:
    print("Вы не ввели ни одного натурального числа.")
